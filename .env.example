# Ключи кабинета FOWYAD: seller.ozon.ru → Настройки → Seller API.
# Нужны только для обновления каталога. На сайте кабинет не называется.
OZON_CLIENT_ID=
OZON_API_KEY=

# Выдача Ozon по бренду FOWYAD. Нужна только обновлению каталога, не кнопке магазина.
NEXT_PUBLIC_OZON_BRAND_URL=https://www.ozon.ru/search/?text=FOWYAD&from_global=true
SYNC_INTERVAL_MINUTES=10

# Публичный адрес сайта. Нужен для canonical, Open Graph и sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Если задан, заменяет почту оператора в политике. Пусто — на сайте 5175568@mail.ru.
NEXT_PUBLIC_LEGAL_CONTACT=
